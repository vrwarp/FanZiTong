# Where the sidecar listens. Inside the container this is 0.0.0.0; the port is
# never published directly — Tailscale or Caddy fronts it with TLS.
FZT_AGENT_HOST=0.0.0.0
FZT_AGENT_PORT=8787

# Shared secret the app sends in its first frame. Required unless the sidecar
# is bound to loopback. Generate one with: openssl rand -base64 32
FZT_AGENT_TOKEN=

# Exact origins allowed to open a socket, comma separated.
# e.g. https://vrwarp.github.io,http://localhost:5173
FZT_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173

# Claude Code credentials. Either set a long-lived token from `claude setup-token`
# on a machine where you are logged in, or leave this empty and run
# `docker compose exec -it agent claude auth login` once (the login is kept in
# the /data/claude volume).
CLAUDE_CODE_OAUTH_TOKEN=

# Optional caps and defaults.
FZT_AGENT_MAX_BUDGET_USD=
FZT_AGENT_MAX_SESSIONS=3
FZT_AGENT_IDLE_TIMEOUT_MS=600000
FZT_AGENT_DETACH_GRACE_MS=180000
FZT_AGENT_RPC_TIMEOUT_MS=60000

# Tailscale profile only: an auth key from the Tailscale admin console.
TS_AUTHKEY=

# Override to run an image published under your own Docker Hub account.
# FZT_AGENT_IMAGE=docker.io/you/fanzitong-agent:latest

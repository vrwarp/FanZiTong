# The domain this assistant answers on. Point its DNS at this host first;
# Caddy gets a certificate for it on first start.
FZT_DOMAIN=agent.example.com

# Where the app is served from, exactly as the browser sends it. Only these
# origins may open a socket or start a sign-in.
FZT_ALLOWED_ORIGINS=https://vrwarp.github.io

# Inside the container the sidecar listens on all interfaces; Caddy is the only
# thing in front of it.
FZT_AGENT_HOST=0.0.0.0
FZT_AGENT_PORT=8787

# Nothing else is required. The assistant is not protected by a shared secret:
# it belongs to whoever signs in to Claude through the app, and only a
# signed-in device can start another sign-in.

# Set this to hand a claimed assistant to a different Claude account, or to
# recover when every device has been signed out. Turn it off again afterwards.
# FZT_ALLOW_RECLAIM=true

# For an assistant that is not signed in through the app — an operator-supplied
# credential from `claude setup-token` — set both of these. A sign-in cannot
# establish ownership in that setup, so a token stands in.
# CLAUDE_CODE_OAUTH_TOKEN=
# FZT_AGENT_TOKEN=

# Optional caps.
FZT_AGENT_MAX_SESSIONS=3
FZT_AGENT_IDLE_TIMEOUT_MS=600000
FZT_AGENT_DETACH_GRACE_MS=180000
FZT_AGENT_RPC_TIMEOUT_MS=60000
# FZT_AGENT_MAX_BUDGET_USD=

# Run an image published under your own Docker Hub account.
# FZT_AGENT_IMAGE=docker.io/you/fanzitong-agent:latest

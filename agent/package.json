{
  "name": "fanzitong-agent",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Sidecar that runs the Claude Agent SDK for the 繁字通 PWA. Holds the Claude Code login; never holds the deck.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.mjs",
    "build": "esbuild src/server.ts --bundle --platform=node --format=esm --target=node22 --packages=external --alias:@=../src --outfile=dist/server.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "validate": "npm run typecheck && npm run test && npm run build"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.261",
    "@anthropic-ai/sdk": "^0.124.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "ws": "^8.21.3",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "@types/ws": "^8.18.1",
    "esbuild": "^0.25.0",
    "tsx": "^4.23.13",
    "typescript": "~5.9.3",
    "vitest": "^4.1.11"
  }
}
